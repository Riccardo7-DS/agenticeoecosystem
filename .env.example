# Copy to .env and obtain credentials through your team's approved channel.
# EVE_ENDPOINT must include the OpenAI-compatible /v1 API path.
EVE_ENDPOINT=https://your-eve-gateway.example/v1
EVE_USERNAME=
EVE_PASSWORD=
OPENROUTER_API_KEY=

# Multi-agent imagery questions use this separate vision model endpoint.
VLM_ENDPOINT=http://localhost:18001/v1
VLM_MODEL=Qwen3-VL

# Copernicus Data Space / Sentinel Hub
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Copernicus Climate Data Store; accept dataset licences in your account.
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_KEY=
# Optional second credential; downloads alternate between distinct keys.
CDS_KEY_2=

# EUMETSAT Data Store / Data Tailor
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# ESA strategy GraphRAG MCP, including the full Authorization header value.
GRAPHRAG_MCP_URL=
GRAPHRAG_AUTH_HEADER=

# EVE knowledge retrieval OAuth
EVE_RETRIEVAL_TOKEN_URL=
EVE_RETRIEVAL_CLIENT_ID=
EVE_RETRIEVAL_CLIENT_SECRET=

# Google Earth Engine: provision the ignored service-account key separately.
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=src/agenticeoecosystem/servers/gee/gee-key.json
GOOGLE_MAPS_API_KEY=
